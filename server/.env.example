# Copy this file to .env and fill in the values. Never commit .env.

# Port the API listens on. The Vite dev server proxies /api to this port.
PORT=4000

# Your Supabase database connection string.
# Supabase dashboard -> Connect (top bar) -> "Session pooler" -> copy the URI,
# then replace [YOUR-PASSWORD] with your database password.
# It looks like:
#   postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# If your password contains special characters (@ : / ? # %), URL-encode them.
DATABASE_URL=

# Optional: path to Supabase's CA certificate to fully verify the SSL connection
# (Project Settings -> Database -> SSL Configuration -> Download certificate).
# Without it the connection is still encrypted.
# DATABASE_CA_CERT=./prod-ca-2021.crt

# Signs admin session cookies. Use a long random string, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# How long an admin stays logged in, in hours.
SESSION_HOURS=8

# Set to false to stop accepting new registrations.
REGISTRATION_OPEN=true

# Set to "production" when deployed (makes the session cookie HTTPS-only).
NODE_ENV=development

# If the server runs behind a reverse proxy or a host like Render/Railway,
# set how many proxies to trust so rate limiting sees real visitor IPs.
TRUST_PROXY=0

# Optional: serve the built client from this folder (same-origin deployment).
# Defaults to ../client/dist when it exists.
# CLIENT_DIST=../client/dist
